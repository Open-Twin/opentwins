## SS-C4. Wait for upload + fill document title + click Done

Pass the carousel title via `data.title` (read from the `title:` line of `linkedin-carousel.md` during preflight):

```bash
exec curl -s -X POST http://localhost:3847/api/browser/{{browser_profile}}/evaluate -H 'Content-Type: application/json' -d @- <<'ENDJSON'
{"fn":"async () => { var host = document.querySelector('#interop-outlet'); var shadow = host.shadowRoot; var done = null; var titleInput = null; for (var i = 0; i < 15; i++) { await new Promise(r => setTimeout(r, 1000)); done = Array.from(shadow.querySelectorAll('button')).find(function(b) { return (b.innerText || '').trim() === 'Done'; }); titleInput = Array.from(shadow.querySelectorAll('input[type=\"text\"]')).find(function(inp) { if (inp.offsetParent === null) return false; var ph = (inp.placeholder || '').toLowerCase(); return ph.includes('descriptive title') || ph.includes('document title'); }); if (done && !done.disabled && titleInput) break; } if (!done || done.disabled) return { success: false, reason: 'done_never_enabled', waited_s: i }; if (!titleInput) return { success: false, reason: 'no_title_input', waited_s: i }; var title = window.__data.title; var setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; setter.call(titleInput, title); titleInput.dispatchEvent(new Event('input', { bubbles: true })); titleInput.dispatchEvent(new Event('change', { bubbles: true })); await new Promise(r => setTimeout(r, 800)); done = Array.from(shadow.querySelectorAll('button')).find(function(b) { return (b.innerText || '').trim() === 'Done' && !b.disabled; }); if (!done) return { success: false, reason: 'done_disabled_after_title' }; done.click(); await new Promise(r => setTimeout(r, 2500)); var editor = shadow.querySelector('[contenteditable=\"true\"][role=\"textbox\"]'); return { success: !!editor, editorBack: !!editor, titleSet: title.slice(0, 80) }; }", "data": {"title": "CAROUSEL_TITLE_HERE"}}
ENDJSON
```

Title is REQUIRED (Done disabled until length > 0). Cap ~100 chars.

